# Variables PÚBLICAS del cliente (Vite las expone al navegador; NO poner secretos aquí).
# Copia este archivo a  frontend/.env  y listo.
# La secret key / connection string NUNCA van aquí — esas son solo del backend/ingesta.

VITE_SUPABASE_URL=https://clrnommkjyksnyrtnisf.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_CL400oeEyfBoEEJdv49Lxg_kCYu-I1g

# Mapa base (Stadia Maps, src/map/baseMap.js). Vacía en localhost: las tiles salen gratis sin llave.
# En un dominio real (Vercel, Netlify) crear una cuenta gratuita en stadiamaps.com y, en su panel
# (Manage Properties > Authentication Configuration), autorizar el dominio: con eso basta y la llave
# puede quedar vacía. Si se prefiere la llave, crear una ahí mismo y ponerla aquí: la web la agrega a
# la URL de las tiles como ?api_key=... (es pública en el navegador, como la de Supabase).
VITE_STADIA_API_KEY=
