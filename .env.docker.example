# Copia este archivo a  .env  (en la raíz) para docker compose. NO subas .env a git.
SUPABASE_URL=https://clrnommkjyksnyrtnisf.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_CL400oeEyfBoEEJdv49Lxg_kCYu-I1g

# SECRETO — connection string para que el WORKER escriba en la BD.
# Supabase -> Settings -> Database -> Connection string (URI). Reemplaza TU_PASSWORD.
# Usa el POOLER (IPv4): la conexion directa db.<ref>.supabase.co es solo IPv6 y Docker no tiene IPv6.
SUPABASE_DB_URL=postgresql://postgres.clrnommkjyksnyrtnisf:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Opcional: departamentos para la lluvia horaria (coma-separado). Por defecto Cajamarca.
SIMPAC_LLUVIA_DEPTS=cajamarca
