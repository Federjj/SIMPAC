# Copia este archivo a  .env  (en la raíz) para docker compose. NO subas .env a git.
SUPABASE_URL=https://clrnommkjyksnyrtnisf.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_CL400oeEyfBoEEJdv49Lxg_kCYu-I1g

# SECRETO — conexión para que el WORKER escriba en la BD.
# Vacío = modo solo lectura: la web y la API funcionan, el worker no actualiza nada (y no intenta
# conectarse: una contraseña equivocada repetida hace que Supabase bloquee la IP un rato).
# Con la contraseña queda así (Supabase -> botón Connect -> Session pooler; reemplaza TU_PASSWORD):
#   SUPABASE_DB_URL=postgresql://postgres.clrnommkjyksnyrtnisf:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
# Usa el POOLER (IPv4): la conexión directa db.<ref>.supabase.co es solo IPv6 y Docker no tiene IPv6.
# Si la contraseña tiene $, encierra todo el valor entre comillas simples; @ : / # ? % van codificados (@ = %40).
SUPABASE_DB_URL=

# Opcional: departamentos cuya serie de lluvia hora por hora se guarda (slugs de SENAMHI
# separados por coma, p. ej. cajamarca,la-libertad). Por defecto Cajamarca.
SIMPAC_LLUVIA_DEPTS=cajamarca

# Opcional: segundos que vive el snapshot en Redis (el worker lo refresca cada 300 s).
SNAPSHOT_TTL=900
