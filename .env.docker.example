# Copia este archivo a  .env  (en la raíz) para docker compose. NO subas .env a git.
# En la nube (Railway: API, worker y Redis; Vercel: web) no hay .env: cada variable se escribe en el
# panel del servicio (Variables). La lista por servicio está en docs/README-tecnico.md §8.5 y en el
# README.md ("Despliegue en Railway y Vercel"). REDIS_URL no va aquí: docker compose la fija al Redis
# del stack y en Railway se referencia al servicio Redis con ${{Redis.REDIS_URL}}.
SUPABASE_URL=https://clrnommkjyksnyrtnisf.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_CL400oeEyfBoEEJdv49Lxg_kCYu-I1g

# SECRETO — conexión para que el WORKER escriba en la BD.
# Vacío = modo solo lectura: la web y la API funcionan, el worker no actualiza nada (y no intenta
# conectarse: una contraseña equivocada repetida hace que Supabase bloquee la IP un rato).
# Con la contraseña queda así (Supabase -> botón Connect -> Session pooler; reemplaza TU_PASSWORD):
#   SUPABASE_DB_URL=postgresql://postgres.clrnommkjyksnyrtnisf:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
# Usa el POOLER (IPv4): la conexión directa db.<ref>.supabase.co es solo IPv6 y Docker no tiene IPv6.
# Si la contraseña tiene $, encierra todo el valor entre comillas simples; @ : / # ? % van codificados (@ = %40).
SUPABASE_DB_URL=

# Opcional: departamentos cuya serie de lluvia hora por hora se guarda (slugs de SENAMHI
# separados por coma, p. ej. cajamarca,la-libertad). Por defecto Cajamarca.
SIMPAC_LLUVIA_DEPTS=cajamarca

# Opcional: segundos que vive el snapshot en Redis (el worker lo refresca cada 300 s).
SNAPSHOT_TTL=900

# Opcional: titular en lenguaje claro por departamento redactado por un modelo de lenguaje
# (tarea 'titular' del worker, cada 30 min). Vacío = el titular lo arman reglas fijas en Python
# (origen 'reglas'), sin ningún pedido externo. Con clave, el worker pide UNA redacción por
# departamento solo cuando cambian sus datos (temperature 0, cifras fijadas, texto validado).
# También vale ANTHROPIC_API_KEY. Modelo por defecto: claude-haiku-4-5-20251001.
SIMPAC_LLM_KEY=
SIMPAC_LLM_MODELO=

# Opcional: orígenes (esquema://host:puerto, separados por coma) a los que la API responde (CORS).
# Vacío = http://localhost:8080,http://localhost:5173,https://localhost,capacitor://localhost
# (la web de Docker, Vite en desarrollo y la app Android). En producción pon el dominio de la web
# (en Railway, p. ej. SIMPAC_CORS_ORIGENES=https://simpac.vercel.app; la app Android no usa CORS).
SIMPAC_CORS_ORIGENES=

# Opcional: notificaciones push por Firebase Cloud Messaging (tarea 'push' del worker, cada 5 min;
# backend/ingesta/push.py). SECRETO: la cuenta de servicio del proyecto Firebase (consola de Firebase ->
# Configuración del proyecto -> Cuentas de servicio -> Generar nueva clave privada). Pon el JSON en
# base64 en UNA línea (así cabe en este archivo y no hay que montar nada en Docker):
#   PowerShell:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("C:\ruta\appsimpac-xxxx.json"))
#   Linux/Mac:   base64 -w0 appsimpac-xxxx.json
# En Railway (no monta archivos) esta es LA forma: la misma línea de PowerShell con  | Set-Clipboard  al
# final deja el base64 en el portapapeles sin mostrarlo, y se pega en la variable FIREBASE_CREDENCIALES
# del servicio worker (docs/README-tecnico.md §8.5).
# También vale la ruta a ese archivo si está dentro del contenedor. Vacío = la tarea no envía nada y lo
# dice en su latido ("push sin credenciales de Firebase: no se envía nada"). NUNCA subas el JSON a git.
FIREBASE_CREDENCIALES=
# Lo más simple con docker compose: la RUTA EN TU MÁQUINA al JSON de la cuenta de servicio (fuera del
# repo). docker-compose.yml lo monta de solo lectura en /run/secrets/firebase.json dentro del worker y
# esa copia manda sobre FIREBASE_CREDENCIALES. En Windows con barras normales y sin comillas, p. ej.
#   FIREBASE_CREDENCIALES_ARCHIVO=C:/Users/tu_usuario/claves/appsimpac-firebase-adminsdk.json
# Vacío = no se monta nada (se usa FIREBASE_CREDENCIALES o la tarea solo deja su latido).
FIREBASE_CREDENCIALES_ARCHIVO=
# Opcional: id del proyecto Firebase (p. ej. appsimpac). Vacío = se lee project_id del JSON.
FIREBASE_PROYECTO=
