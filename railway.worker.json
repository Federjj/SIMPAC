{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend/Dockerfile",
    "watchPatterns": ["backend/**", "railway.worker.json"]
  },
  "deploy": {
    "startCommand": "celery -A backend.celery_app worker --beat --loglevel=info --concurrency 2",
    "restartPolicyType": "ALWAYS"
  }
}
