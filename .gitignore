/*.sql

# GeoJSON generados desde IDESEP/SENAMHI: no se redistribuyen en el repo.
# Viven en la BD y se regeneran con backend/mapas/cargar_fen.py --exportar
*.geojson
# Excepción: los ríos vigilados son datos revisados a mano que carga backend/mapas/cargar_rios.py
!/backend/data/rios/**/*.geojson
# ... y las copias simplificadas de los cauces del país (ANA - GeoSNIRH, ~2,8 MB) que
# carga backend/mapas/cargar_cauces.py --desde-copia sin volver a consultar a ANA
!/backend/data/cauces/*.geojson

# Base de datos local del prototipo
*.db
*.sqlite
*.sqlite3

