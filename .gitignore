# Python
__pycache__/
*.py[cod]
/.venv/
/venv/
/env/
celerybeat-schedule*

# Secretos (las plantillas .example sí se versionan)
.env
.env.*
*.env
!.env.docker.example
!**/.env.example

# Node / frontend
node_modules/
dist/
/frontend/build/
.next/

# Datos cacheados / temporales
*.log
/cache/
/data/cache/
/*.sql

# GeoJSON generados desde IDESEP/SENAMHI: no se redistribuyen en el repo.
# Viven en la BD y se regeneran con backend/mapas/cargar_fen.py --exportar
*.geojson
# Excepción: los ríos vigilados son datos revisados a mano que carga backend/mapas/cargar_rios.py
!/backend/data/rios/**/*.geojson
# ... y las copias simplificadas de los cauces del país (ANA - GeoSNIRH, ~2,8 MB) que
# carga backend/mapas/cargar_cauces.py --desde-copia sin volver a consultar a ANA
!/backend/data/cauces/*.geojson

# Base de datos local del prototipo
*.db
*.sqlite
*.sqlite3

# Documentos del curso (informe, backlogs, matrices): viven en el OneDrive del equipo
/Proyecto_G01/

# SO / editores
.DS_Store
Thumbs.db
.idea/
.vscode/

# Firma de la app: nunca al repo
key.properties
*.jks
*.keystore

# Cuenta de servicio de Firebase (avisador push): secreto, nunca al repo. Va en .env como base64
# (FIREBASE_CREDENCIALES, ver .env.docker.example) o fuera del repo.
*firebase-adminsdk*.json
# Zonas que podrían inundarse junto a los ríos del país, estimadas con el relieve
# (backend/mapas/zonas_relieve.py, ~3 MB) que carga backend/mapas/cargar_cauces_zonas.py
!/backend/data/cauces_zonas/*.geojson

# App Android nativa (Kotlin + Jetpack Compose, proyecto en appmobile/android). El proyecto se
# versiona; lo que generan Gradle y Android Studio, no. google-services.json (Firebase) se descarga
# de la consola y nunca va al repo.
/appmobile/android/.gradle/
/appmobile/android/build/
/appmobile/android/app/build/
/appmobile/android/local.properties
/appmobile/android/.idea/
/appmobile/android/*.iml
/appmobile/android/app/*.iml
/appmobile/android/.kotlin/
/appmobile/android/app/google-services.json
/appmobile/android/key.properties
